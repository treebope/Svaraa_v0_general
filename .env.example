# Svaraa app settings. Copy this file to .env and fill in the values.
# Everything starting with EXPO_PUBLIC_ is built into the app and can be read by anyone:
# never put a secret here (no JWT secret, no client secret, no Groq or Deepgram key).
# After changing this file, restart with: npx expo start --clear

# ---------------------------------------------------------------- Server
# Which server this build talks to: local | dev | staging | prod
EXPO_PUBLIC_APP_ENV=dev

# Backend host WITHOUT /api/v1
#   dev server (Render):        https://svaraa-backend.onrender.com
#   backend on your computer:   http://192.168.x.x:8000  (your computer's Wi-Fi IP; localhost does not work on a phone)
#   Android emulator:           http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=https://svaraa-backend.onrender.com

# Voice socket host (wss:// for https servers). Leave empty to derive it from EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_WS_URL=wss://svaraa-backend.onrender.com

# Request timeout in ms. Render's free tier sleeps; the first request can take 30-60 s.
EXPO_PUBLIC_API_TIMEOUT_MS=60000

# ---------------------------------------------------------------- Mock or real
# Master switch. Keep true: each area is switched to the real server in config/flags.ts.
# false sends EVERY call to the server, including ones it does not have yet.
EXPO_PUBLIC_USE_MOCKS=true

# Send single endpoints to the real server while mocks stay on. Comma separated, or * for all, e.g.
# EXPO_PUBLIC_REAL_ENDPOINTS=POST /api/v1/auth/otp/request,POST /api/v1/auth/otp/verify
EXPO_PUBLIC_REAL_ENDPOINTS=

# Areas that use the real server on this computer (comma separated): auth, googleSignIn, household, notifications, ai (chat).
# The defaults in config/flags.ts stay 'mock'. googleSignIn needs auth too.
EXPO_PUBLIC_REAL_AREAS=

# ---------------------------------------------------------------- Setup link
# Host of the wearer's setup link (https://svaraa.ai/j/<token>). Links from other hosts are ignored.
EXPO_PUBLIC_SETUP_LINK_HOST=svaraa.ai

# ---------------------------------------------------------------- Google sign-in
# OAuth client IDs from Google Cloud Console. Public, not secrets.
# All three must be in the SAME Google Cloud project.
# WEB: the ID token is issued for this one, on phones too. It must be in the backend's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# IOS: client for bundle ID ai.svaraa. Also add it to the backend's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# ANDROID: client for package ai.svaraa + the SHA-1 of each signing key. Not read by code; kept here for reference.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ---------------------------------------------------------------- Dev helpers
# Show "use 000000" under the code field. Only while the server has no SMS provider. Never true in prod.
EXPO_PUBLIC_SHOW_DEV_OTP_HINT=true
