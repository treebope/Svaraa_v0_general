{
  "name": "svaraa-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.2",
    "@tanstack/react-query": "^5.105.1",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.7.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "lint-staged": "^17.6.0",
    "msw": "^2.10.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:server": "expo start --web --port 5173",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "api:generate": "openapi-typescript docs/openapi.json -o services/api/schema.d.ts",
    "build:web": "expo export --platform web",
    "prepare": "husky",
    "check": "npm run lint && npm run typecheck && npm test && npm run i18n:check",
    "start:dev": "expo start --dev-client"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
