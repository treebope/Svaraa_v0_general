{
  "expo": {
    "name": "svaraa",
    "slug": "svaraa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.svaraa",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Svaraa uses Bluetooth to talk to your pendant."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#46012A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.svaraa",
      "permissions": ["android.permission.BLUETOOTH_SCAN", "android.permission.BLUETOOTH_CONNECT"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "svaraa",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-asset",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Svaraa uses the camera to scan the code in your pendant's box.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Svaraa shares where you are with your family only during an SOS, even when the app is closed.",
          "locationWhenInUsePermission": "Svaraa shares where you are with your family only during an SOS.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ]
    ]
  }
}
